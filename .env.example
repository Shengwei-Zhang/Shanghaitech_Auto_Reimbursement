# Node.js 22+; default URL is http://127.0.0.1:4317
PORT=4317
OA_DATA_DIR=data

# Enable after checking access to the university OA network.
# Default: log in on the school page. Optional per-task credentials are never persisted.
OA_LIVE_ENABLED=false
# Optional receipt verification profile, calibrated against actual OA responses/pages.
# Leave empty to require OA result review; automatic receipt verification will be unavailable.
OA_SITE_PROFILE=
# Legacy CLI execution scope: submit verifies the form and route, then confirms once; save only saves.
OA_ACTION=submit
# new: create using the 2026-09-16 recorded entry; reuse: legacy recent-form checks.
OA_FORM_MODE=new
PLAYWRIGHT_EXECUTABLE_PATH=
# Remember the local account's school login after successful manual/scan-code login.
# Optional; cookies remain only on this computer. Expired sessions require login again.
OA_REMEMBER_SESSION=false
# Empty: <OA_DATA_DIR>/browser-session/storage-state.json, shared by connect/CLI/web workers.
# If overriding, use a dedicated private directory (its permissions are set to 0700).
OA_SESSION_STATE_PATH=

# Optional DeepSeek: JSON plan generation and business ambiguity review, only after opt-in.
# Set the key locally (never in browser code or Git); restart the server after changing it.
# Uses https://api.deepseek.com/chat/completions with deepseek-chat and a 20-second timeout.
DEEPSEEK_API_KEY=

# Legacy CLI only. Web workers do not inherit these values.
# manual: log in directly on the school page; credentials: fill the values below.
OA_LOGIN_MODE=manual
OA_USERNAME=
OA_PASSWORD=
UPLOAD_FILE_PATH=
REIMBURSEMENT_PURPOSE=
REIMBURSEMENT_REASON=
PAYEE_PERSON_CODE=
# Funding category: 被授权的项目 (default) or 我负责的项目.
FUNDING_KIND_KEYWORD=被授权的项目
FUNDING_ITEM_KEYWORD=
BUDGET_OUTLAY_KEYWORD=
ATTACHMENT_COUNT=1
# Actual reimbursement amount; may be less than the invoice total.
EXPECTED_AMOUNT=
EXPECTED_INVOICE_AMOUNT=
EXPECTED_INVOICE_NUMBER=
PLAYWRIGHT_TIMEOUT_MS=20000
HEADLESS=false
START_FROM=
RESUME_EXISTING=false
CHROME_DEBUGGER_ADDRESS=
PLAYWRIGHT_CDP_ENDPOINT=
KEEP_BROWSER_OPEN=false
PAUSE_ON_FAILURE=false
# Debug dumps may contain personal information. Disabled for web workers.
CAPTURE_DEBUG_ARTIFACTS=false
